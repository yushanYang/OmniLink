# ── OmniLink 环境变量示例 ──
# 复制为 .env 并填入真实值。切勿提交 .env 到 git。

# ===== TRON / 合约 (packages/contracts) =====
# 部署私钥（测试网账号，绝不要用主网/真实资产私钥）
TRON_PRIVATE_KEY=your_test_net_private_key_here
# TRON 网络节点：Nile 测试网
TRON_FULL_NODE=https://nile.trongrid.io
TRON_SOLIDITY_NODE=https://nile.trongrid.io
TRON_EVENT_SERVER=https://nile.trongrid.io
# 部署后回填：DeviceRegistry 合约地址
DEVICE_REGISTRY_ADDRESS=

# ===== AI 控制层 (packages/ai) =====
# LLM API Key（OpenAI 兼容接口）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Signaling / P2P (packages/device) =====
# 简易 WebSocket signaling 服务器端口
SIGNALING_PORT=8080
SIGNALING_URL=ws://localhost:8080
# 公共 STUN（P2P 打洞）
STUN_URL=stun:stun.l.google.com:19302
# TURN 中继兜底（coturn，可选）
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ===== Web 客户端 (packages/web) =====
VITE_SIGNALING_URL=ws://localhost:8080
VITE_DEVICE_REGISTRY_ADDRESS=
