# OmniLink Web runtime mode
# Leave all URLs empty to use local mock mode.

# Contract/registry HTTP adapter base URL.
# Expected endpoints are documented in ../../docs/api-contracts.md.
VITE_OMNILINK_REGISTRY_API=

# Device/P2P HTTP adapter base URL.
VITE_OMNILINK_PEER_API=

# AI Agent HTTP adapter base URL.
VITE_OMNILINK_AI_API=
