# === OmniLink Device 配置 ===

# 设备标识
DEVICE_ID=omnilink-lock-001

# Signaling 服务器
SIGNALING_URL=ws://localhost:8080
SIGNALING_PORT=8080

# STUN 服务器（P2P 打洞）
STUN_URL=stun:stun.l.google.com:19302

# === TRON 链上注册配置 ===
# 网络: nile(测试网) / mainnet
TRON_NETWORK=nile
# Nile 测试网 fullNode
TRON_FULL_NODE=https://nile.trongrid.io
# 设备私钥（用于签发注册交易，测试网可用水龙头领取 TRX）
TRON_PRIVATE_KEY=your_device_private_key_hex_here
# DeviceRegistry 合约地址（Base58 格式，由 good person 部署后回填）
DEVICE_REGISTRY_ADDRESS=TXxxxxxxxxxxxxxxxxxxxxxxxxxxxx
